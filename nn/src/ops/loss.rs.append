
// Additional loss functions needed for compatibility

/// L1 Loss.
///
/// Computes the mean absolute error.
pub fn l1_loss<B, S, T>(
    input: &Tensor<B, S, T>,
    target: &Tensor<B, S, T>,
) -> Result<Tensor<B, S, T>>
where
    B: Backend<Data = T> + Clone + Default + Send + Sync + 'static,
    S: Storage<T> + Clone + Send + Sync + 'static + StorageFromVec<T> + StorageToDense<T> + tensor::ops::arithmetic::traits::TensorStorageArithmetic<T>,
    T: DataType + FloatExt + PartialOrd + num_traits::FromPrimitive + Copy + Send + Sync + 'static,
{
    // Delegate to tensor::ops or implement (mean(abs(input - target)))
    // Assuming tensor::ops::l1_loss exists or implementing it via ops
    // tensor::ops::abs(input - target).mean()
    let diff = (input - target)?;
    let abs_diff = tensor::ops::abs(&diff)?;
    let mean = tensor::ops::mean(&abs_diff)?;
    Ok(mean)
}

