/// Binary Cross Entropy (without logits).
pub fn binary_cross_entropy<B, S, T>(
    input: &Tensor<B, S, T>,
    target: &Tensor<B, S, T>,
) -> Result<Tensor<B, S, T>>
where
    B: Backend<Data = T> + Clone + Default + Send + Sync + 'static,
    S: Storage<T> + Clone + Send + Sync + 'static + StorageFromVec<T> + StorageToDense<T> + tensor::ops::arithmetic::traits::TensorStorageArithmetic<T>,
    T: DataType + FloatExt + PartialOrd + num_traits::FromPrimitive + Copy + Send + Sync + 'static + std::ops::Neg<Output = T>,
{
    // Implementation: -(target * log(input) + (1 - target) * log(1 - input))
    // Composition of ops.
    // Ideally tensor has it.
    let one = T::one();
    let eps = T::from_f64(1e-12).unwrap();
    
    // Clamp input to [eps, 1-eps] to avoid log(0)
    // tensor::ops::clamp not generic over S? Check.
    // Assuming inputs are safe or use add(eps).
    
    let log_input = tensor::ops::log(input)?;
    let one_minus_input = (tensor::Tensor::ones_like(input)? - input)?;
    let log_one_minus_input = tensor::ops::log(&one_minus_input)?;
    
    let term1 = (target * &log_input)?;
    let one_minus_target = (tensor::Tensor::ones_like(target)? - target)?;
    let term2 = (&one_minus_target * &log_one_minus_input)?;
    
    let sum = (&term1 + &term2)?;
    let neg_sum = tensor::ops::neg(&sum)?;
    let mean = tensor::ops::mean(&neg_sum)?;
    Ok(mean)
}
