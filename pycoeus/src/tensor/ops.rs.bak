use super::class::{to_py_err, Device, PyTensor, TensorWrapper};
use crate::{dispatch_binary, dispatch_tensor, dispatch_tensor_mut, dispatch_unary};
use backend::CpuBackend;
#[cfg(feature = "gpu")]
use backend::GpuBackend;
use dtype::float::{Float32, Float64};
use numpy::{PyReadonlyArrayDyn, PyUntypedArrayMethods};
use pyo3::prelude::*;
use storage::DenseStorage;
use tensor::ops::{arithmetic, comparison};
use tensor::tensor_core::Tensor;

#[pymethods]
impl PyTensor {
    #[new]
    #[pyo3(signature = (data, shape=None))]
    fn new(data: &Bound<PyAny>, shape: Option<Vec<usize>>) -> PyResult<Self> {
        if let Ok(arr) = data.extract::<PyReadonlyArrayDyn<'_, f32>>() {
            let shape = arr.shape().to_vec();
            let flat = arr
                .as_slice()
                .map_err(|_| {
                    PyErr::new::<pyo3::exceptions::PyValueError, _>(
                        "Tensor data must be a contiguous NumPy array",
                    )
                })?
                .iter()
                .copied()
                .map(Float32)
                .collect::<Vec<_>>();
            let tensor = Tensor::from_vec(flat, &shape).map_err(to_py_err)?;
            return Ok(PyTensor {
                inner: TensorWrapper::CpuDenseF32(tensor),
            });
        }

        if let Ok(arr) = data.extract::<PyReadonlyArrayDyn<'_, f64>>() {
            let shape = arr.shape().to_vec();
            let flat = arr
                .as_slice()
                .map_err(|_| {
                    PyErr::new::<pyo3::exceptions::PyValueError, _>(
                        "Tensor data must be a contiguous NumPy array",
                    )
                })?
                .iter()
                .copied()
                .map(Float64)
                .collect::<Vec<_>>();
            let tensor = Tensor::from_vec(flat, &shape).map_err(to_py_err)?;
            return Ok(PyTensor {
                inner: TensorWrapper::CpuDenseF64(tensor),
            });
        }

        if let Ok(flat) = data.extract::<Vec<f32>>() {
            let shape = shape.unwrap_or_else(|| vec![flat.len()]);
            let float_data: Vec<Float32> = flat.into_iter().map(Float32).collect();
            let tensor = Tensor::from_vec(float_data, &shape).map_err(to_py_err)?;
            return Ok(PyTensor {
                inner: TensorWrapper::CpuDenseF32(tensor),
            });
        }

        Err(PyErr::new::<pyo3::exceptions::PyTypeError, _>(
            "Tensor data must be a Python list or a NumPy ndarray",
        ))
    }

    /// Returns a copy of the tensor
    pub fn clone(&self) -> PyResult<PyTensor> {
        Ok(PyTensor {
            inner: self.inner.clone(),
        })
    }

    /// Returns a new tensor, detached from the current graph.
    pub fn detach(&self) -> PyResult<PyTensor> {
        let mut cloned = self.inner.clone();
        cloned = cloned.requires_grad_(false);
        Ok(PyTensor { inner: cloned })
    }

    /// Returns a contiguous tensor containing the same data as self tensor.
    pub fn contiguous(&self) -> PyResult<PyTensor> {
        self.clone()
    }

    /// Returns the type of the tensor
    #[pyo3(name = "type")]
    pub fn py_type(&self) -> String {
        match &self.inner {
            TensorWrapper::CpuDenseF32(_) | TensorWrapper::CpuSparseF32(_) => {
                "torch.FloatTensor".to_string()
            }
            TensorWrapper::CpuDenseF64(_) | TensorWrapper::CpuSparseF64(_) => {
                "torch.DoubleTensor".to_string()
            }
            #[cfg(feature = "gpu")]
            TensorWrapper::GpuDenseF32(_) => "torch.cuda.FloatTensor".to_string(),
        }
    }

    /// Casts this tensor to the type of the given tensor.
    pub fn type_as(&self, other: &PyTensor) -> PyResult<PyTensor> {
        // Simple implementation for now: if types match, return clone, else error (parity needed)
        let self_type = self.py_type();
        let other_type = other.py_type();
        if self_type == other_type {
            self.clone()
        } else {
            Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                format!(
                    "type_as not yet implemented for {} to {}",
                    self_type, other_type
                ),
            ))
        }
    }

    /// Element-wise inverse tangent of input_1/input_2
    pub fn atan2(&self, other: &PyTensor) -> PyResult<PyTensor> {
        dispatch_binary!(self, other, a, b => tensor::ops::atan2(a, b)?)
    }

    /// Extract a scalar value from a single-element tensor
    pub fn item(&self) -> PyResult<f64> {
        match &self.inner {
            TensorWrapper::CpuDenseF32(inner) => {
                if inner.shape().size() != 1 {
                    return Err(PyErr::new::<pyo3::exceptions::PyValueError, _>(
                        "item() can only be called on single-element tensors",
                    ));
                }
                Ok(inner.as_slice()[0].get() as f64)
            }
            TensorWrapper::CpuDenseF64(inner) => {
                if inner.shape().size() != 1 {
                    return Err(PyErr::new::<pyo3::exceptions::PyValueError, _>(
                        "item() can only be called on single-element tensors",
                    ));
                }
                Ok(inner.as_slice()[0].get())
            }
            #[cfg(feature = "gpu")]
            TensorWrapper::GpuDenseF32(inner) => {
                if inner.shape().size() != 1 {
                    return Err(PyErr::new::<pyo3::exceptions::PyValueError, _>(
                        "item() can only be called on single-element tensors",
                    ));
                }
                Ok(inner.as_slice()[0].get() as f64)
            }
            TensorWrapper::CpuSparseF32(_) | TensorWrapper::CpuSparseF64(_) => {
                Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                    "item() not implemented for sparse tensors",
                ))
            }
        }
    }

    /// Convert tensor to NumPy array
    pub fn numpy(&self, py: Python) -> PyResult<Py<PyAny>> {
        self.__array__(py, None, None)
    }

    pub fn __array__(
        &self,
        py: Python,
        _dtype: Option<Py<PyAny>>,
        _context: Option<Py<PyAny>>,
    ) -> PyResult<Py<PyAny>> {
        use numpy::{PyArray1, PyArrayMethods};

        match &self.inner {
            TensorWrapper::CpuDenseF32(inner) => {
                let data: Vec<f64> = inner.as_slice().iter().map(|f| f.get() as f64).collect();
                let array = PyArray1::from_vec(py, data);
                let shape = inner.shape().dims();
                let shaped_array = array.reshape(shape).map_err(|e| {
                    PyErr::new::<pyo3::exceptions::PyValueError, _>(format!(
                        "Reshape failed: {}",
                        e
                    ))
                })?;
                Ok(shaped_array.into())
            }
            TensorWrapper::CpuDenseF64(inner) => {
                let data: Vec<f64> = inner.as_slice().iter().map(|f| f.get()).collect();
                let array = PyArray1::from_vec(py, data);
                let shape = inner.shape().dims();
                let shaped_array = array.reshape(shape).map_err(|e| {
                    PyErr::new::<pyo3::exceptions::PyValueError, _>(format!(
                        "Reshape failed: {}",
                        e
                    ))
                })?;
                Ok(shaped_array.into())
            }
            #[cfg(feature = "gpu")]
            TensorWrapper::GpuDenseF32(inner) => {
                let data: Vec<f64> = inner.as_slice().iter().map(|f| f.get() as f64).collect();
                let array = PyArray1::from_vec(py, data);
                let shape = inner.shape().dims();
                let shaped_array = array.reshape(shape).map_err(|e| {
                    PyErr::new::<pyo3::exceptions::PyValueError, _>(format!(
                        "Reshape failed: {}",
                        e
                    ))
                })?;
                Ok(shaped_array.into())
            }
            TensorWrapper::CpuSparseF32(_) | TensorWrapper::CpuSparseF64(_) => {
                Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                    "__array__ not implemented for sparse tensors",
                ))
            }
        }
    }

    pub fn __add__(&self, other: &PyTensor) -> PyResult<PyTensor> {
        dispatch_binary!(self, other, a, b => a + b)
    }

    pub fn __sub__(&self, other: &PyTensor) -> PyResult<PyTensor> {
        dispatch_binary!(self, other, a, b => a - b)
