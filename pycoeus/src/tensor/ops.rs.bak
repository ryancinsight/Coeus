    #[getter]
    pub fn shape(&self) -> Vec<usize> {
        dispatch_tensor!(self, inner => inner.shape().dims().to_vec())
    }

    pub fn size(&self) -> Vec<usize> {
        self.shape()
    }

    #[getter]
    pub fn dtype(&self) -> String {
        match self.inner {
            TensorWrapper::CpuDenseF32(_) | TensorWrapper::CpuSparseF32(_) => "float32".to_string(),
            TensorWrapper::CpuDenseF64(_) | TensorWrapper::CpuSparseF64(_) => "float64".to_string(),
            #[cfg(feature = "gpu")]
            TensorWrapper::GpuDenseF32(_) => "float32".to_string(),
        }
    }

    #[getter]
    pub fn device(&self) -> Device {
        match self.inner {
            TensorWrapper::CpuDenseF32(_)
            | TensorWrapper::CpuDenseF64(_)
            | TensorWrapper::CpuSparseF32(_)
            | TensorWrapper::CpuSparseF64(_) => Device::CPU,
            #[cfg(feature = "gpu")]
            TensorWrapper::GpuDenseF32(_) => Device::CUDA,
        }
    }

    #[getter]
    pub fn data(&self) -> PyTensor {
        self.clone()
    }

    pub fn clamp(&self, min: f64, max: f64) -> PyResult<PyTensor> {
        match &self.inner {
            TensorWrapper::CpuDenseF32(t) => {
                let res = t
                    .clamp(Float32::new(min as f32), Float32::new(max as f32))
                    .map_err(to_py_err)?;
                Ok(PyTensor {
                    inner: TensorWrapper::CpuDenseF32(res),
                })
            }
            TensorWrapper::CpuDenseF64(t) => {
                let res = t
                    .clamp(Float64::new(min), Float64::new(max))
                    .map_err(to_py_err)?;
                Ok(PyTensor {
                    inner: TensorWrapper::CpuDenseF64(res),
                })
            }
            #[cfg(feature = "gpu")]
            TensorWrapper::GpuDenseF32(t) => {
                let res = t
                    .clamp(Float32::new(min as f32), Float32::new(max as f32))
                    .map_err(to_py_err)?;
                Ok(PyTensor {
                    inner: TensorWrapper::GpuDenseF32(res),
                })
            }
            _ => Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                "clamp not implemented for this tensor type",
            )),
        }
    }

    pub fn add_scalar(&self, value: f64) -> PyResult<PyTensor> {
        // Workaround: create a scalar tensor with the same shape filled with the value and add
        let dtype = self.dtype();
        let scalar_tensor = Self::full(self.shape(), value, Some(dtype.as_str()), Some("cpu"))?;
        self.__add__(&scalar_tensor)
    }

    pub fn add_scalar_f64(&self, value: f64) -> PyResult<PyTensor> {
        self.add_scalar(value)
    }

    // Matrix Ops
    pub fn matmul(&self, other: &PyTensor) -> PyResult<PyTensor> {
        dispatch_binary!(self, other, a, b => a.matmul(b).map_err(to_py_err)?)
    }

    pub fn bmm(&self, other: &PyTensor) -> PyResult<PyTensor> {
        dispatch_binary!(self, other, a, b => a.bmm(b).map_err(to_py_err)?)
    }

    #[pyo3(signature = (mat1, mat2, beta=1.0, alpha=1.0))]
    pub fn addmm(
        &self,
        mat1: &PyTensor,
        mat2: &PyTensor,
        beta: f32,
        alpha: f32,
    ) -> PyResult<PyTensor> {
        match (&self.inner, &mat1.inner, &mat2.inner) {
            (
                TensorWrapper::CpuDenseF32(a),
                TensorWrapper::CpuDenseF32(b),
                TensorWrapper::CpuDenseF32(c),
            ) => {
                let res = a
                    .addmm(b, c, Float32(beta), Float32(alpha))
                    .map_err(to_py_err)?;
                Ok(PyTensor {
                    inner: TensorWrapper::CpuDenseF32(res),
                })
            }
            (
                TensorWrapper::CpuDenseF64(a),
                TensorWrapper::CpuDenseF64(b),
                TensorWrapper::CpuDenseF64(c),
            ) => {
                let res = a
                    .addmm(b, c, Float64(beta as f64), Float64(alpha as f64))
                    .map_err(to_py_err)?;
                Ok(PyTensor {
                    inner: TensorWrapper::CpuDenseF64(res),
                })
            }
            (TensorWrapper::CpuSparseF32(_), _, _)
            | (_, TensorWrapper::CpuSparseF32(_), _)
            | (_, _, TensorWrapper::CpuSparseF32(_))
            | (TensorWrapper::CpuSparseF64(_), _, _)
            | (_, TensorWrapper::CpuSparseF64(_), _)
            | (_, _, TensorWrapper::CpuSparseF64(_)) => {
                Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                    "addmm not implemented for sparse tensors",
                ))
            }
            _ => Err(PyErr::new::<pyo3::exceptions::PyTypeError, _>(
                "Tensor mismatch in addmm",
            )),
        }
    }

    // Shape Ops
    pub fn reshape(&self, shape: Vec<isize>) -> PyResult<PyTensor> {
        dispatch_unary!(self, inner => inner.reshape(&shape))
    }

    pub fn view(&self, shape: Vec<isize>) -> PyResult<PyTensor> {
        self.reshape(shape)
    }

    #[pyo3(signature = (*dims))]
    pub fn permute(&self, dims: &Bound<'_, pyo3::types::PyTuple>) -> PyResult<PyTensor> {
        let perm: Vec<usize> = if dims.len() == 1 {
            if let Ok(list) = dims.get_item(0)?.extract::<Vec<usize>>() {
                list
            } else {
                dims.extract::<Vec<usize>>()?
            }
        } else {
            dims.extract::<Vec<usize>>()?
        };

        dispatch_unary!(self, inner => inner.permute(&perm))
    }

    pub fn flatten(&self, start_dim: usize, end_dim: isize) -> PyResult<PyTensor> {
        dispatch_unary!(self, inner => inner.flatten(start_dim, end_dim))
    }

    pub fn squeeze(&self, dim: Option<usize>) -> PyResult<PyTensor> {
        match dim {
            Some(d) => dispatch_unary!(self, inner => inner.squeeze(d)),
            None => {
                // Squeeze all dims of size 1
                let mut current = self.clone();
                let dims = self.inner.shape().dims();
                let mut offset = 0;
                for (i, &size) in dims.iter().enumerate() {
                    if size == 1 {
                        let inner = match &current.inner {
                            TensorWrapper::CpuDenseF32(t) => TensorWrapper::CpuDenseF32(
                                t.squeeze(i - offset).map_err(to_py_err)?,
                            ),
                            TensorWrapper::CpuDenseF64(t) => TensorWrapper::CpuDenseF64(
                                t.squeeze(i - offset).map_err(to_py_err)?,
                            ),
                            #[cfg(feature = "gpu")]
                            TensorWrapper::GpuDenseF32(t) => TensorWrapper::GpuDenseF32(
                                t.squeeze(i - offset).map_err(to_py_err)?,
                            ),
                            _ => {
                                return Err(
                                    PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                                        "Squeeze not implemented for this tensor type",
                                    ),
                                )
                            }
                        };
                        current.inner = inner;
                        offset += 1;
                    }
                }
                Ok(current)
            }
        }
    }

    pub fn unsqueeze(&self, dim: usize) -> PyResult<PyTensor> {
        dispatch_unary!(self, inner => inner.unsqueeze(dim))
    }

    pub fn transpose(&self, dim0: usize, dim1: usize) -> PyResult<PyTensor> {
        dispatch_unary!(self, inner => inner.transpose(dim0, dim1))
    }

    /// Detach tensor from computation graph
    /// Creates a new tensor without gradient tracking

    #[getter]
    pub fn grad(&self) -> PyResult<Option<PyTensor>> {
        match &self.inner {
            TensorWrapper::CpuDenseF32(inner) => match inner.grad() {
                Ok(grad) => Ok(Some(PyTensor {
                    inner: TensorWrapper::CpuDenseF32(grad),
                })),
                Err(_) => Ok(None),
            },
            TensorWrapper::CpuDenseF64(inner) => match inner.grad() {
                Ok(grad) => Ok(Some(PyTensor {
                    inner: TensorWrapper::CpuDenseF64(grad),
                })),
                Err(_) => Ok(None),
            },
            #[cfg(feature = "gpu")]
            TensorWrapper::GpuDenseF32(inner) => match inner.grad() {
                Ok(grad) => Ok(Some(PyTensor {
                    inner: TensorWrapper::GpuDenseF32(grad),
                })),
                Err(_) => Ok(None),
            },
            TensorWrapper::CpuSparseF32(_) | TensorWrapper::CpuSparseF64(_) => {
                Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                    "Grad not implemented for sparse tensors",
                ))
            }
        }
    }

    fn requires_grad(&self) -> bool {
        dispatch_tensor!(self, inner => inner.requires_grad())
    }

    #[pyo3(signature = (dim=None, keepdim=false))]
    pub fn argmax(&self, dim: Option<usize>, keepdim: bool) -> PyResult<PyTensor> {
        dispatch_unary!(self, inner => inner.argmax(dim, keepdim))
    }

    #[pyo3(signature = (dim=None, keepdim=false))]
    pub fn argmin(&self, dim: Option<usize>, keepdim: bool) -> PyResult<PyTensor> {
        dispatch_unary!(self, inner => inner.argmin(dim, keepdim))
    }

    /// Sum of all elements or along a dimension
    #[pyo3(signature = (dim=None, keepdim=false))]
    pub fn sum(&self, dim: Option<usize>, keepdim: bool) -> PyResult<PyTensor> {
        dispatch_unary!(self, inner => {
            match dim {
                Some(d) => inner.sum_dims(Some(&[d]), keepdim),
                None => Ok(inner.sum_all()),
            }
        })
    }

    /// Mean of all elements or along a dimension
    #[pyo3(signature = (dim=None, keepdim=false))]
    pub fn mean(&self, dim: Option<usize>, keepdim: bool) -> PyResult<PyTensor> {
        dispatch_unary!(self, inner => {
            match dim {
                Some(d) => inner.mean_dims(Some(&[d]), keepdim),
                None => Ok(inner.mean_all()),
            }
        })
    }

    /// Max of all elements or along a dimension
    #[pyo3(signature = (dim=None, keepdim=false))]
    pub fn max(&self, dim: Option<usize>, keepdim: bool) -> PyResult<PyTensor> {
        dispatch_unary!(self, inner => inner.max_dims(dim.as_ref().map(std::slice::from_ref), keepdim))
    }

    /// Min of all elements or along a dimension
    #[pyo3(signature = (dim=None, keepdim=false))]
    pub fn min(&self, dim: Option<usize>, keepdim: bool) -> PyResult<PyTensor> {
        dispatch_unary!(self, inner => inner.min_dims(dim.as_ref().map(std::slice::from_ref), keepdim))
    }

    fn requires_grad_(&mut self, requires_grad: bool) -> PyResult<()> {
        let inner = std::mem::replace(
            &mut self.inner,
            TensorWrapper::CpuDenseF32(Tensor::zeros(&[0]).map_err(to_py_err)?),
        );
        self.inner = inner.requires_grad_(requires_grad);
        Ok(())
    }

    #[pyo3(signature = (gradient=None))]
    fn backward(&self, gradient: Option<&PyTensor>) -> PyResult<()> {
        match gradient {
            Some(g) => match (&self.inner, &g.inner) {
                (TensorWrapper::CpuDenseF32(a), TensorWrapper::CpuDenseF32(b)) => {
                    a.backward_with_grad(b).map_err(to_py_err)
                }
                (TensorWrapper::CpuDenseF64(a), TensorWrapper::CpuDenseF64(b)) => {
                    a.backward_with_grad(b).map_err(to_py_err)
                }
                #[cfg(feature = "gpu")]
                (TensorWrapper::GpuDenseF32(a), TensorWrapper::GpuDenseF32(b)) => {
                    a.backward_with_grad(b).map_err(to_py_err)
                }
                (TensorWrapper::CpuSparseF32(_), _)
                | (_, TensorWrapper::CpuSparseF32(_))
                | (TensorWrapper::CpuSparseF64(_), _)
                | (_, TensorWrapper::CpuSparseF64(_)) => {
                    Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                        "backward not implemented for sparse tensors",
                    ))
                }
                _ => Err(PyErr::new::<pyo3::exceptions::PyTypeError, _>(
                    "Tensor mismatch in backward",
                )),
            },
            None => {
                dispatch_tensor!(self, inner => inner.backward().map_err(to_py_err))
            }
        }
    }

    // Device Management
    pub fn cpu(&self) -> PyResult<PyTensor> {
        match &self.inner {
            TensorWrapper::CpuDenseF32(_)
            | TensorWrapper::CpuDenseF64(_)
            | TensorWrapper::CpuSparseF32(_)
            | TensorWrapper::CpuSparseF64(_) => Ok(self.clone()),
            #[cfg(feature = "gpu")]
            TensorWrapper::GpuDenseF32(inner) => {
                let cpu_backend = CpuBackend::<Float32>::default();
                let cpu_tensor = inner.to_cpu_dense().map_err(to_py_err)?;
                Ok(PyTensor {
                    inner: TensorWrapper::CpuDenseF32(cpu_tensor),
                })
            }
        }
    }

    pub fn cuda(&self) -> PyResult<PyTensor> {
        #[cfg(feature = "gpu")]
        {
            match &self.inner {
                TensorWrapper::GpuDenseF32(_) => Ok(self.clone()),
                TensorWrapper::CpuDenseF32(inner) => {
                    let gpu_backend = GpuBackend::<Float32>::default();
                    let gpu_tensor = inner.to_backend(&gpu_backend).map_err(to_py_err)?;
                    Ok(PyTensor {
                        inner: TensorWrapper::GpuDenseF32(gpu_tensor),
                    })
                }
                TensorWrapper::CpuSparseF32(_) | TensorWrapper::CpuSparseF64(_) => {
                    Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                        "CUDA transfer not implemented for sparse tensors",
                    ))
                }
                _ => Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                    "CUDA transfer only implemented for F32",
                )),
            }
        }
        #[cfg(not(feature = "gpu"))]
        {
            Err(PyErr::new::<pyo3::exceptions::PyRuntimeError, _>(
                "GPU support not enabled",
            ))
        }
    }

    pub fn detach(&self) -> PyTensor {
        match &self.inner {
            TensorWrapper::CpuDenseF32(t) => PyTensor {
                inner: TensorWrapper::CpuDenseF32(t.clone().detach()),
            },
            TensorWrapper::CpuDenseF64(t) => PyTensor {
                inner: TensorWrapper::CpuDenseF64(t.clone().detach()),
            },
            TensorWrapper::CpuSparseF32(t) => PyTensor {
                inner: TensorWrapper::CpuSparseF32(t.clone().detach()),
            },
            TensorWrapper::CpuSparseF64(t) => PyTensor {
                inner: TensorWrapper::CpuSparseF64(t.clone().detach()),
            },
            #[cfg(feature = "gpu")]
            TensorWrapper::GpuDenseF32(t) => PyTensor {
                inner: TensorWrapper::GpuDenseF32(t.clone().detach()),
            },
        }
    }

    #[pyo3(signature = (device=None, dtype=None))]
    pub fn to(&self, device: Option<&str>, dtype: Option<&str>) -> PyResult<PyTensor> {
        let mut res = self.clone();

        if let Some(d) = device {
            res = match d {
                "cpu" => res.cpu()?,
                "cuda" | "gpu" => res.cuda()?,
                _ => {
                    return Err(PyErr::new::<pyo3::exceptions::PyValueError, _>(format!(
                        "Invalid device: {}",
                        d
                    )))
                }
            };
        }

        if let Some(dt) = dtype {
            res = match (dt, &res.inner) {
                ("float32", TensorWrapper::CpuDenseF32(_)) => res,
                ("float32", TensorWrapper::CpuDenseF64(inner)) => {
                    let data = inner
                        .as_slice()
                        .iter()
                        .map(|f| Float32(f.get() as f32))
                        .collect();
                    let t = Tensor::from_vec(data, inner.shape().dims()).map_err(to_py_err)?;
                    PyTensor {
                        inner: TensorWrapper::CpuDenseF32(t),
                    }
                }
                ("float64", TensorWrapper::CpuDenseF64(_)) => res,
                ("float64", TensorWrapper::CpuDenseF32(inner)) => {
                    let data = inner
                        .as_slice()
                        .iter()
                        .map(|f| Float64(f.get() as f64))
                        .collect();
                    let t = Tensor::from_vec(data, inner.shape().dims()).map_err(to_py_err)?;
                    PyTensor {
                        inner: TensorWrapper::CpuDenseF64(t),
                    }
                }
                _ => {
                    return Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                        format!(
                            "Dtype conversion to {} not implemented yet for this backend",
                            dt
                        ),
                    ))
                }
            };
        }

        Ok(res)
    }

    pub fn to_sparse(&self) -> PyResult<PyTensor> {
        match &self.inner {
            TensorWrapper::CpuDenseF32(t) => {
                let mut data = Vec::new();
                let mut row_indices = Vec::new();
                let mut col_indices = Vec::new();
                let dims = t.shape().dims();
                let slice = t.as_slice();
                for r in 0..dims[0] {
                    for c in 0..dims[1] {
                        let idx = r * dims[1] + c;
                        let val = slice[idx];
                        if val.get() != 0.0 {
                            data.push(val);
                            row_indices.push(r);
                            col_indices.push(c);
                        }
                    }
                }
                let coo = storage::CooStorage::new(data, row_indices, col_indices, dims)
                    .map_err(to_py_err)?;
                let csr = coo.to_csr();
                let sparse_tensor = Tensor::from_storage(csr, t.backend().clone());
                Ok(PyTensor {
                    inner: TensorWrapper::CpuSparseF32(sparse_tensor),
                })
            }
            TensorWrapper::CpuDenseF64(t) => {
                let mut data = Vec::new();
                let mut row_indices = Vec::new();
                let mut col_indices = Vec::new();
                let dims = t.shape().dims();
                let slice = t.as_slice();
                for r in 0..dims[0] {
                    for c in 0..dims[1] {
                        let idx = r * dims[1] + c;
                        let val = slice[idx];
                        if val.get() != 0.0 {
                            data.push(val);
                            row_indices.push(r);
                            col_indices.push(c);
                        }
                    }
                }
                let coo = storage::CooStorage::new(data, row_indices, col_indices, dims)
                    .map_err(to_py_err)?;
                let csr = coo.to_csr();
                let sparse_tensor = Tensor::from_storage(csr, t.backend().clone());
                Ok(PyTensor {
                    inner: TensorWrapper::CpuSparseF64(sparse_tensor),
                })
            }
            _ => Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                "to_sparse only implemented for CPU dense tensors",
            )),
        }
    }

    pub fn to_dense(&self) -> PyResult<PyTensor> {
        match &self.inner {
            TensorWrapper::CpuDenseF32(_) | TensorWrapper::CpuDenseF64(_) => Ok(self.clone()),
            #[cfg(feature = "gpu")]
            TensorWrapper::GpuDenseF32(_) => Ok(self.clone()),
            TensorWrapper::CpuSparseF32(t) => {
                let dense_t = t.to_dense_generic().map_err(to_py_err)?;
                Ok(PyTensor {
                    inner: TensorWrapper::CpuDenseF32(dense_t),
                })
            }
            TensorWrapper::CpuSparseF64(t) => {
                let dense_t = t.to_dense_generic().map_err(to_py_err)?;
                Ok(PyTensor {
                    inner: TensorWrapper::CpuDenseF64(dense_t),
                })
            }
        }
    }

    // ========== CLONING AND MEMORY ==========

    /// Clone the tensor (deep copy)
    #[pyo3(name = "clone")]
    pub fn tensor_clone(&self) -> PyTensor {
        PyTensor {
            inner: self.inner.clone(),
        }
    }

    /// Returns a contiguous tensor
    pub fn contiguous(&self) -> PyTensor {
        // Our tensors are always contiguous in DenseStorage
        PyTensor {
            inner: self.inner.clone(),
        }
    }

    // ========== TENSOR PROPERTIES ==========

    /// Number of elements in the tensor
    pub fn numel(&self) -> usize {
        self.inner.shape().size()
    }

    /// Number of dimensions
    #[pyo3(name = "ndim")]
    pub fn dim_count(&self) -> usize {
        self.inner.shape().dims().len()
    }

    // ========== COMPARISON OPERATIONS ==========

    /// Element-wise equality
    pub fn eq(&self, other: &PyTensor) -> PyResult<PyTensor> {
        dispatch_binary!(self, other, a, b => comparison::eq(a, b).map_err(to_py_err)?)
    }

    /// Element-wise not equal
    pub fn ne(&self, other: &PyTensor) -> PyResult<PyTensor> {
        dispatch_binary!(self, other, a, b => comparison::ne(a, b).map_err(to_py_err)?)
    }

    /// Element-wise greater than
    pub fn gt(&self, other: &PyTensor) -> PyResult<PyTensor> {
        dispatch_binary!(self, other, a, b => comparison::gt(a, b).map_err(to_py_err)?)
    }

    /// Element-wise greater than or equal
    pub fn ge(&self, other: &PyTensor) -> PyResult<PyTensor> {
        dispatch_binary!(self, other, a, b => comparison::ge(a, b).map_err(to_py_err)?)
    }

    /// Element-wise less than
    pub fn lt(&self, other: &PyTensor) -> PyResult<PyTensor> {
        dispatch_binary!(self, other, a, b => comparison::lt(a, b).map_err(to_py_err)?)
    }

    /// Element-wise less than or equal
    pub fn le(&self, other: &PyTensor) -> PyResult<PyTensor> {
        dispatch_binary!(self, other, a, b => comparison::le(a, b).map_err(to_py_err)?)
    }

    // ========== IN-PLACE OPERATIONS ==========

    /// Fill tensor with zeros in-place
    pub fn zero_(&mut self) -> PyResult<()> {
        dispatch_tensor_mut!(self, inner => inner.zero_());
        Ok(())
    }

    /// Fill tensor with a value in-place
    pub fn fill_(&mut self, value: f64) -> PyResult<()> {
        match &mut self.inner {
            TensorWrapper::CpuDenseF32(inner) => {
                let val = Float32(value as f32);
                for x in inner.as_mut_slice() {
                    *x = val;
                }
            }
            TensorWrapper::CpuDenseF64(inner) => {
                let val = Float64(value);
                for x in inner.as_mut_slice() {
                    *x = val;
                }
            }
            #[cfg(feature = "gpu")]
            TensorWrapper::GpuDenseF32(_) => {
                return Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                    "GPU fill_ not implemented",
                ))
            }
            TensorWrapper::CpuSparseF32(_) | TensorWrapper::CpuSparseF64(_) => {
                return Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                    "In-place fill_ not implemented for sparse tensors",
                ));
            }
        }
        Ok(())
    }

    /// Add a scalar in-place
    #[pyo3(name = "add_")]
    pub fn add_inplace(&mut self, value: f64) -> PyResult<()> {
        match &mut self.inner {
            TensorWrapper::CpuDenseF32(inner) => {
                for x in inner.as_mut_slice() {
                    *x = Float32(x.get() + value as f32);
                }
            }
            TensorWrapper::CpuDenseF64(inner) => {
                for x in inner.as_mut_slice() {
                    *x = Float64(x.get() + value);
                }
            }
            TensorWrapper::CpuSparseF32(_) | TensorWrapper::CpuSparseF64(_) => {
                return Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                    "In-place add not implemented for sparse tensors",
                ));
            }
        }
        Ok(())
    }

    /// Multiply by a scalar in-place
    #[pyo3(name = "mul_")]
    pub fn mul_inplace(&mut self, value: f64) -> PyResult<()> {
        match &mut self.inner {
            TensorWrapper::CpuDenseF32(inner) => {
                inner
                    .mul_scalar_(Float32(value as f32))
                    .map_err(to_py_err)?;
            }
            TensorWrapper::CpuDenseF64(inner) => {
                inner.mul_scalar_(Float64(value)).map_err(to_py_err)?;
            }
            TensorWrapper::CpuSparseF32(_) | TensorWrapper::CpuSparseF64(_) => {
                return Err(PyErr::new::<pyo3::exceptions::PyNotImplementedError, _>(
                    "In-place mul not implemented for sparse tensors",
                ));
            }
        }
        Ok(())
    }
}

