    ld.global.u32 %off_b, [%rd_bl];
    ld.global.u32 %ndim_c, [%rd_cl+4];
    ld.global.u32 %ndim_a, [%rd_al+4];
    ld.global.u32 %ndim_b, [%rd_bl+4];

    mov.u32 %temp, %idx;
    mov.u32 %d, 0;

COORD_LOOP:
    setp.ge.u32 %p_loop, %d, %ndim_c;
    @%p_loop bra COORD_END;

    mul.wide.u32 %stride_c_addr, %d, 4;
    add.u64 %stride_c_addr, %rd_cl, %stride_c_addr;
    ld.global.u32 %stride_c, [%stride_c_addr+40];

    div.u32 %coord, %temp, %stride_c;
    rem.u32 %temp, %temp, %stride_c;

    sub.u32 %diff_a, %ndim_c, %ndim_a;
    setp.ge.u32 %p_a_in, %d, %diff_a;
    @!%p_a_in bra CHECK_B;

    add.u32 %ad, %d, %ndim_a;
    sub.u32 %ad, %ad, %ndim_c;

    mul.wide.u32 %shape_a_addr, %ad, 4;
    add.u64 %shape_a_addr, %rd_al, %shape_a_addr;
    ld.global.u32 %shape_a_val, [%shape_a_addr+8];

    setp.gt.u32 %p_a_shape, %shape_a_val, 1;
