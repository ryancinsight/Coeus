    mad.lo.s32 %go_off, %oc, %stride_go_1, %go_off;
    mad.lo.s32 %go_off, %ol, %stride_go_2, %go_off;
    
    mul.wide.s32 %addr_go, %go_off, 4;
    add.u64 %addr_go, %rd_go, %addr_go;
    
    ld.global.f32 %goval, [%addr_go];
    add.f32 %sum, %sum, %goval;
    
    add.u32 %ol, %ol, 1;
    bra OL_LOOP;
OL_END:
    add.u32 %ni, %ni, 1;
    bra NI_LOOP;
NI_END:
    mul.wide.s32 %addr_gb, %oc, 4;
    add.u64 %addr_gb, %rd_gb, %addr_gb;
    
    ld.global.f32 %old_gb, [%addr_gb];
    add.f32 %new_gb, %old_gb, %sum;
    st.global.f32 [%addr_gb], %new_gb;
    
L_exit:
    ret;
}

.visible .entry conv2d_grad_input_f32(
    .param .u64 grad_out,
    .param .u64 weight,
    .param .u64 grad_input,
    .param .u64 go_layout,
    .param .u64 w_layout,
    .param .u64 gi_layout,
    .param .u32 stride,
    .param .u32 padding,
    .param .u32 dilation,
    .param .u32 numel_in
) {
    .reg .pred %p_ikh, %p_ikw, %p_oc;
    .reg .s32 %rem_h, %rem_w;
    .reg .pred %p1, %p_h_ge, %p_h_rem, %p_h_lt, %p_w_ge, %p_w_rem, %p_w_lt;
    .reg .f32 %sum, %goval, %wval, %prod, %old_gi, %new_gi;
    .reg .s32 %idx, %r2, %r3, %num_in, %wi, %temp1, %hi, %temp2, %ic, %ni, %numer_h, %ikh_dil, %oh, %numer_w, %ikw_dil, %ow, %oc, %ikh, %ikw;
    .reg .u32 %n, %c_in, %h, %w, %c_out, %kh, %kw, %h_out, %w_out;
    .reg .s32 %stride_s, %pad_s, %dil_s;
    .reg .u32 %go_off, %stride_go_0, %stride_go_1, %stride_go_2, %stride_go_3;
    .reg .u32 %w_off, %stride_w_0, %stride_w_1, %stride_w_2, %stride_w_3;
    .reg .u32 %gi_off, %stride_gi_0, %stride_gi_1, %stride_gi_2, %stride_gi_3;
    .reg .u64 %rd_go, %rd_w, %rd_gi, %rd_gol, %rd_wl, %rd_gil, %addr_go, %addr_w, %addr_gi;

    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    .reg .s32 %t_x;
    mov.u32 %t_x, %tid.x;
    mad.lo.s32 %idx, %r2, %r3, %t_x;
    
    ld.param.u32 %num_in, [numel_in];
    setp.ge.u32 %p1, %idx, %num_in;
    @%p1 bra L_exit;
    
    ld.param.u64 %rd_go, [grad_out];
    ld.param.u64 %rd_w, [weight];
    ld.param.u64 %rd_gi, [grad_input];
    ld.param.u64 %rd_gol, [go_layout];
    ld.param.u64 %rd_wl, [w_layout];
    ld.param.u64 %rd_gil, [gi_layout];
    
    ld.global.u32 %n, [%rd_gil+8];
    ld.global.u32 %c_in, [%rd_gil+12];
    ld.global.u32 %h, [%rd_gil+16];
    ld.global.u32 %w, [%rd_gil+20];
    ld.global.u32 %c_out, [%rd_wl+8];
    ld.global.u32 %kh, [%rd_wl+16];
    ld.global.u32 %kw, [%rd_wl+20];
    ld.global.u32 %h_out, [%rd_gol+16];
    ld.global.u32 %w_out, [%rd_gol+20];
    
    div.u32 %temp1, %idx, %w;
    rem.u32 %wi, %idx, %w;
    div.u32 %temp2, %temp1, %h;
    rem.u32 %hi, %temp1, %h;
    div.u32 %ni, %temp2, %c_in;
    rem.u32 %ic, %temp2, %c_in;
    
    ld.param.s32 %stride_s, [stride];
    ld.param.s32 %pad_s, [padding];
    ld.param.s32 %dil_s, [dilation];
    
    mov.f32 %sum, 0f00000000;
    
    mov.u32 %oc, 0;
OC_LOOP:
    setp.ge.u32 %p_oc, %oc, %c_out;
    @%p_oc bra OC_END;
    
    mov.u32 %ikh, 0;
IKH_LOOP:
    setp.ge.u32 %p_ikh, %ikh, %kh;
    @%p_ikh bra IKH_END;
    
    add.s32 %numer_h, %hi, %pad_s;
    mul.lo.s32 %ikh_dil, %ikh, %dil_s;
    sub.s32 %numer_h, %numer_h, %ikh_dil;
    
    setp.ge.s32 %p_h_ge, %numer_h, 0;
    @!%p_h_ge bra NEXT_IKH;
    
    rem.s32 %rem_h, %numer_h, %stride_s;
    setp.eq.s32 %p_h_rem, %rem_h, 0;
    @!%p_h_rem bra NEXT_IKH;
    
    div.s32 %oh, %numer_h, %stride_s;
    setp.lt.s32 %p_h_lt, %oh, %h_out;
    @!%p_h_lt bra NEXT_IKH;
    
    mov.u32 %ikw, 0;
IKW_LOOP:
    setp.ge.u32 %p_ikw, %ikw, %kw;
    @%p_ikw bra IKW_END;
    
    add.s32 %numer_w, %wi, %pad_s;
    mul.lo.s32 %ikw_dil, %ikw, %dil_s;
    sub.s32 %numer_w, %numer_w, %ikw_dil;
    
    setp.ge.s32 %p_w_ge, %numer_w, 0;
    @!%p_w_ge bra NEXT_IKW;
    
    rem.s32 %rem_w, %numer_w, %stride_s;
    setp.eq.s32 %p_w_rem, %rem_w, 0;
    @!%p_w_rem bra NEXT_IKW;
    
    div.s32 %ow, %numer_w, %stride_s;
    setp.lt.s32 %p_w_lt, %ow, %w_out;
    @!%p_w_lt bra NEXT_IKW;
    
    ld.global.u32 %go_off, [%rd_gol];
    ld.global.u32 %stride_go_0, [%rd_gol+40];
    ld.global.u32 %stride_go_1, [%rd_gol+44];
    ld.global.u32 %stride_go_2, [%rd_gol+48];
    ld.global.u32 %stride_go_3, [%rd_gol+52];
    mad.lo.s32 %go_off, %ni, %stride_go_0, %go_off;
    mad.lo.s32 %go_off, %oc, %stride_go_1, %go_off;
    mad.lo.s32 %go_off, %oh, %stride_go_2, %go_off;
    mad.lo.s32 %go_off, %ow, %stride_go_3, %go_off;
    
    ld.global.u32 %w_off, [%rd_wl];
    ld.global.u32 %stride_w_0, [%rd_wl+40];
    ld.global.u32 %stride_w_1, [%rd_wl+44];
    ld.global.u32 %stride_w_2, [%rd_wl+48];
    ld.global.u32 %stride_w_3, [%rd_wl+52];
    mad.lo.s32 %w_off, %oc, %stride_w_0, %w_off;
    mad.lo.s32 %w_off, %ic, %stride_w_1, %w_off;
    mad.lo.s32 %w_off, %ikh, %stride_w_2, %w_off;
    mad.lo.s32 %w_off, %ikw, %stride_w_3, %w_off;
    
    mul.wide.s32 %addr_go, %go_off, 4;
    add.u64 %addr_go, %rd_go, %addr_go;
    mul.wide.s32 %addr_w, %w_off, 4;
    add.u64 %addr_w, %rd_w, %addr_w;
    
    ld.global.f32 %goval, [%addr_go];
    ld.global.f32 %wval, [%addr_w];
    mul.f32 %prod, %goval, %wval;
    add.f32 %sum, %sum, %prod;
    
NEXT_IKW:
    add.u32 %ikw, %ikw, 1;
    bra IKW_LOOP;
IKW_END:
NEXT_IKH:
    add.u32 %ikh, %ikh, 1;
    bra IKH_LOOP;
IKH_END:
    add.u32 %oc, %oc, 1;
    bra OC_LOOP;
OC_END:
    ld.global.u32 %gi_off, [%rd_gil];
    ld.global.u32 %stride_gi_0, [%rd_gil+40];
    ld.global.u32 %stride_gi_1, [%rd_gil+44];
    ld.global.u32 %stride_gi_2, [%rd_gil+48];
    ld.global.u32 %stride_gi_3, [%rd_gil+52];
    mad.lo.s32 %gi_off, %ni, %stride_gi_0, %gi_off;
    mad.lo.s32 %gi_off, %ic, %stride_gi_1, %gi_off;
    mad.lo.s32 %gi_off, %hi, %stride_gi_2, %gi_off;
    mad.lo.s32 %gi_off, %wi, %stride_gi_3, %gi_off;
    
    mul.wide.s32 %addr_gi, %gi_off, 4;
    add.u64 %addr_gi, %rd_gi, %addr_gi;
    
    ld.global.f32 %old_gi, [%addr_gi];
    add.f32 %new_gi, %old_gi, %sum;
    st.global.f32 [%addr_gi], %new_gi;
    
L_exit:
    ret;
}

.visible .entry conv2d_grad_weight_f32(
    .param .u64 grad_out,
    .param .u64 input,
    .param .u64 grad_weight,
    .param .u64 go_layout,
    .param .u64 in_layout,
    .param .u64 gw_layout,
    .param .u32 stride,
    .param .u32 padding,
    .param .u32 dilation,
    .param .u32 numel_w
) {
    .reg .pred %p_ni, %p_oh, %p_ow;
    .reg .pred %p1, %p_h_ge, %p_h_lt, %p_h_bounds, %p_w_ge, %p_w_lt, %p_w_bounds;
    .reg .f32 %sum, %goval, %ival, %prod, %old_gw, %new_gw;
    .reg .s32 %idx, %r2, %r3, %num_w, %ikw, %temp1, %ikh, %temp2, %ic, %oc, %h_in, %ikh_dil, %w_in, %ikw_dil;
    .reg .u32 %c_out, %c_in, %kh, %kw, %n, %h, %w, %h_out, %w_out, %ni, %oh, %ow;
    .reg .s32 %stride_s, %pad_s, %dil_s;
    .reg .u32 %go_off, %stride_go_0, %stride_go_1, %stride_go_2, %stride_go_3;
    .reg .u32 %in_off, %stride_in_0, %stride_in_1, %stride_in_2, %stride_in_3;
    .reg .u32 %gw_off, %stride_gw_0, %stride_gw_1, %stride_gw_2, %stride_gw_3;
    .reg .u64 %rd_go, %rd_in, %rd_gw, %rd_gol, %rd_inl, %rd_gwl, %addr_go, %addr_in, %addr_gw;

    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    .reg .s32 %t_x;
    mov.u32 %t_x, %tid.x;
    mad.lo.s32 %idx, %r2, %r3, %t_x;
    
    ld.param.u32 %num_w, [numel_w];
    setp.ge.u32 %p1, %idx, %num_w;
    @%p1 bra L_exit;
    
    ld.param.u64 %rd_go, [grad_out];
    ld.param.u64 %rd_in, [input];
    ld.param.u64 %rd_gw, [grad_weight];
    ld.param.u64 %rd_gol, [go_layout];
    ld.param.u64 %rd_inl, [in_layout];
    ld.param.u64 %rd_gwl, [gw_layout];
    
    ld.global.u32 %c_out, [%rd_gwl+8];
    ld.global.u32 %c_in, [%rd_gwl+12];
    ld.global.u32 %kh, [%rd_gwl+16];
    ld.global.u32 %kw, [%rd_gwl+20];
    ld.global.u32 %n, [%rd_inl+8];
    ld.global.u32 %h, [%rd_inl+16];
    ld.global.u32 %w, [%rd_inl+20];
    ld.global.u32 %h_out, [%rd_gol+16];
    ld.global.u32 %w_out, [%rd_gol+20];
    
    div.u32 %temp1, %idx, %kw;
    rem.u32 %ikw, %idx, %kw;
    div.u32 %temp2, %temp1, %kh;
    rem.u32 %ikh, %temp1, %kh;
    div.u32 %oc, %temp2, %c_in;
    rem.u32 %ic, %temp2, %c_in;
    
    ld.param.s32 %stride_s, [stride];
    ld.param.s32 %pad_s, [padding];
    ld.param.s32 %dil_s, [dilation];
    
    mov.f32 %sum, 0f00000000;
    
    mov.u32 %ni, 0;
NI_LOOP:
    setp.ge.u32 %p_ni, %ni, %n;
    @%p_ni bra NI_END;
    
    mov.u32 %oh, 0;
OH_LOOP:
    setp.ge.u32 %p_oh, %oh, %h_out;
    @%p_oh bra OH_END;
    
    mul.lo.s32 %h_in, %oh, %stride_s;
    mul.lo.s32 %ikh_dil, %ikh, %dil_s;
    add.s32 %h_in, %h_in, %ikh_dil;
    sub.s32 %h_in, %h_in, %pad_s;
    
    setp.ge.s32 %p_h_ge, %h_in, 0;
    setp.lt.s32 %p_h_lt, %h_in, %h;
    and.pred %p_h_bounds, %p_h_ge, %p_h_lt;
    @!%p_h_bounds bra NEXT_OH;
    
    mov.u32 %ow, 0;
OW_LOOP:
    setp.ge.u32 %p_ow, %ow, %w_out;
    @%p_ow bra OW_END;
    
    mul.lo.s32 %w_in, %ow, %stride_s;
    mul.lo.s32 %ikw_dil, %ikw, %dil_s;
    add.s32 %w_in, %w_in, %ikw_dil;
    sub.s32 %w_in, %w_in, %pad_s;
    
    setp.ge.s32 %p_w_ge, %w_in, 0;
    setp.lt.s32 %p_w_lt, %w_in, %w;
    and.pred %p_w_bounds, %p_w_ge, %p_w_lt;
    @!%p_w_bounds bra NEXT_OW;
    
    ld.global.u32 %go_off, [%rd_gol];
    ld.global.u32 %stride_go_0, [%rd_gol+40];
    ld.global.u32 %stride_go_1, [%rd_gol+44];
    ld.global.u32 %stride_go_2, [%rd_gol+48];
    ld.global.u32 %stride_go_3, [%rd_gol+52];
    mad.lo.s32 %go_off, %ni, %stride_go_0, %go_off;
    mad.lo.s32 %go_off, %oc, %stride_go_1, %go_off;
    mad.lo.s32 %go_off, %oh, %stride_go_2, %go_off;
    mad.lo.s32 %go_off, %ow, %stride_go_3, %go_off;
    
    ld.global.u32 %in_off, [%rd_inl];
    ld.global.u32 %stride_in_0, [%rd_inl+40];
    ld.global.u32 %stride_in_1, [%rd_inl+44];
    ld.global.u32 %stride_in_2, [%rd_inl+48];
    ld.global.u32 %stride_in_3, [%rd_inl+52];
    mad.lo.s32 %in_off, %ni, %stride_in_0, %in_off;
    mad.lo.s32 %in_off, %ic, %stride_in_1, %in_off;
    mad.lo.s32 %in_off, %h_in, %stride_in_2, %in_off;
    mad.lo.s32 %in_off, %w_in, %stride_in_3, %in_off;
    
    mul.wide.s32 %addr_go, %go_off, 4;
    add.u64 %addr_go, %rd_go, %addr_go;
    mul.wide.s32 %addr_in, %in_off, 4;
    add.u64 %addr_in, %rd_in, %addr_in;
    
    ld.global.f32 %goval, [%addr_go];
    ld.global.f32 %ival, [%addr_in];
    mul.f32 %prod, %goval, %ival;
    add.f32 %sum, %sum, %prod;
    
NEXT_OW:
    add.u32 %ow, %ow, 1;
    bra OW_LOOP;
OW_END:
NEXT_OH:
    add.u32 %oh, %oh, 1;
    bra OH_LOOP;
OH_END:
    add.u32 %ni, %ni, 1;
    bra NI_LOOP;
NI_END:
    ld.global.u32 %gw_off, [%rd_gwl];
    ld.global.u32 %stride_gw_0, [%rd_gwl+40];
    ld.global.u32 %stride_gw_1, [%rd_gwl+44];
    ld.global.u32 %stride_gw_2, [%rd_gwl+48];
    ld.global.u32 %stride_gw_3, [%rd_gwl+52];
    mad.lo.s32 %gw_off, %oc, %stride_gw_0, %gw_off;
    mad.lo.s32 %gw_off, %ic, %stride_gw_1, %gw_off;
    mad.lo.s32 %gw_off, %ikh, %stride_gw_2, %gw_off;
    mad.lo.s32 %gw_off, %ikw, %stride_gw_3, %gw_off;
    
    mul.wide.s32 %addr_gw, %gw_off, 4;
    add.u64 %addr_gw, %rd_gw, %addr_gw;
    
    ld.global.f32 %old_gw, [%addr_gw];
    add.f32 %new_gw, %old_gw, %sum;
    st.global.f32 [%addr_gw], %new_gw;
    
L_exit:
    ret;
}

.visible .entry conv2d_grad_bias_f32(
    .param .u64 grad_out,
    .param .u64 grad_bias,
    .param .u64 go_layout,
    .param .u32 c_out
) {
    .reg .pred %p_ni, %p_oh, %p_ow;
    .reg .pred %p1;
    .reg .f32 %sum, %goval, %old_gb, %new_gb;
    .reg .s32 %oc, %r2, %r3, %channels;
    .reg .u32 %n, %h_out, %w_out, %ni, %oh, %ow;
    .reg .u32 %go_off, %stride_go_0, %stride_go_1, %stride_go_2, %stride_go_3;
    .reg .u64 %rd_go, %rd_gb, %rd_gol, %addr_go, %addr_gb;

    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    .reg .s32 %t_x;
    mov.u32 %t_x, %tid.x;
    mad.lo.s32 %oc, %r2, %r3, %t_x;
    
    ld.param.u32 %channels, [c_out];
    setp.ge.u32 %p1, %oc, %channels;
    @%p1 bra L_exit;
    
    ld.param.u64 %rd_go, [grad_out];
    ld.param.u64 %rd_gb, [grad_bias];
    ld.param.u64 %rd_gol, [go_layout];
    
    ld.global.u32 %n, [%rd_gol+8];
    ld.global.u32 %h_out, [%rd_gol+16];
    ld.global.u32 %w_out, [%rd_gol+20];
    
    mov.f32 %sum, 0f00000000;
    
    mov.u32 %ni, 0;
NI_LOOP:
    setp.ge.u32 %p_ni, %ni, %n;
    @%p_ni bra NI_END;
    
    mov.u32 %oh, 0;
OH_LOOP:
    setp.ge.u32 %p_oh, %oh, %h_out;
    @%p_oh bra OH_END;
    
    mov.u32 %ow, 0;
OW_LOOP:
    setp.ge.u32 %p_ow, %ow, %w_out;
    @%p_ow bra OW_END;
    
    ld.global.u32 %go_off, [%rd_gol];
    ld.global.u32 %stride_go_0, [%rd_gol+40];
    ld.global.u32 %stride_go_1, [%rd_gol+44];
    ld.global.u32 %stride_go_2, [%rd_gol+48];
    ld.global.u32 %stride_go_3, [%rd_gol+52];
    mad.lo.s32 %go_off, %ni, %stride_go_0, %go_off;
    mad.lo.s32 %go_off, %oc, %stride_go_1, %go_off;
    mad.lo.s32 %go_off, %oh, %stride_go_2, %go_off;
    mad.lo.s32 %go_off, %ow, %stride_go_3, %go_off;
    
    mul.wide.s32 %addr_go, %go_off, 4;
    add.u64 %addr_go, %rd_go, %addr_go;
    
    ld.global.f32 %goval, [%addr_go];
    add.f32 %sum, %sum, %goval;
    
    add.u32 %ow, %ow, 1;
    bra OW_LOOP;
OW_END:
    add.u32 %oh, %oh, 1;
    bra OH_LOOP;
OH_END:
    add.u32 %ni, %ni, 1;
    bra NI_LOOP;
NI_END:
    mul.wide.s32 %addr_gb, %oc, 4;
    add.u64 %addr_gb, %rd_gb, %addr_gb;
    
    ld.global.f32 %old_gb, [%addr_gb];
    add.f32 %new_gb, %old_gb, %sum;
    st.global.f32 [%addr_gb], %new_gb;
    
L_exit:
    ret;
}

.visible .entry add_strided_f32(.param .u64 a, .param .u64 b, .param .u64 c, .param .u64 a_layout, .param .u64 b_layout, .param .u64 c_layout, .param .u32 n) {
    .reg .pred %p1, %p_loop, %p_a_in, %p_b_in, %p_a_shape, %p_b_shape;
    .reg .f32 %f1, %f2, %f3;
    .reg .s32 %r1, %r2, %r3, %idx, %temp;
    .reg .u32 %ndim_c, %ndim_a, %ndim_b, %d, %off_a, %off_b, %stride_c, %coord, %diff_a, %ad, %shape_a_val, %stride_a_val, %diff_b, %bd, %shape_b_val, %stride_b_val;
    .reg .u64 %rd_a, %rd_b, %rd_c, %rd_al, %rd_bl, %rd_cl, %stride_c_addr, %shape_a_addr, %stride_a_val_addr, %shape_b_addr, %stride_b_val_addr, %addr_a, %addr_b, %addr_c;

    ld.param.u64 %rd_a, [a];
    ld.param.u64 %rd_b, [b];
    ld.param.u64 %rd_c, [c];
    ld.param.u64 %rd_al, [a_layout];
    ld.param.u64 %rd_bl, [b_layout];
    ld.param.u64 %rd_cl, [c_layout];
    ld.param.u32 %r1, [n];

    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    .reg .s32 %t_x;
    mov.u32 %t_x, %tid.x;
    mad.lo.s32 %idx, %r2, %r3, %t_x;
    setp.ge.s32 %p1, %idx, %r1;
    @%p1 bra L_exit;

    ld.global.u32 %off_a, [%rd_al];
    ld.global.u32 %off_b, [%rd_bl];
    ld.global.u32 %ndim_c, [%rd_cl+4];
    ld.global.u32 %ndim_a, [%rd_al+4];
    ld.global.u32 %ndim_b, [%rd_bl+4];

    mov.u32 %temp, %idx;
    mov.u32 %d, 0;

COORD_LOOP:
    setp.ge.u32 %p_loop, %d, %ndim_c;
    @%p_loop bra COORD_END;

    mul.wide.u32 %stride_c_addr, %d, 4;
    add.u64 %stride_c_addr, %rd_cl, %stride_c_addr;
    ld.global.u32 %stride_c, [%stride_c_addr+40];

    div.u32 %coord, %temp, %stride_c;
    rem.u32 %temp, %temp, %stride_c;

    sub.u32 %diff_a, %ndim_c, %ndim_a;
    setp.ge.u32 %p_a_in, %d, %diff_a;
    @!%p_a_in bra CHECK_B;

    add.u32 %ad, %d, %ndim_a;
    sub.u32 %ad, %ad, %ndim_c;

    mul.wide.u32 %shape_a_addr, %ad, 4;
    add.u64 %shape_a_addr, %rd_al, %shape_a_addr;
    ld.global.u32 %shape_a_val, [%shape_a_addr+8];

    setp.gt.u32 %p_a_shape, %shape_a_val, 1;
    @!%p_a_shape bra CHECK_B;

    mul.wide.u32 %stride_a_val_addr, %ad, 4;
    add.u64 %stride_a_val_addr, %rd_al, %stride_a_val_addr;
    ld.global.u32 %stride_a_val, [%stride_a_val_addr+40];

    mad.lo.u32 %off_a, %coord, %stride_a_val, %off_a;

CHECK_B:
    sub.u32 %diff_b, %ndim_c, %ndim_b;
    setp.ge.u32 %p_b_in, %d, %diff_b;
    @!%p_b_in bra NEXT_ITER;

    add.u32 %bd, %d, %ndim_b;
    sub.u32 %bd, %bd, %ndim_c;

    mul.wide.u32 %shape_b_addr, %bd, 4;
    add.u64 %shape_b_addr, %rd_bl, %shape_b_addr;
    ld.global.u32 %shape_b_val, [%shape_b_addr+8];

    setp.gt.u32 %p_b_shape, %shape_b_val, 1;
    @!%p_b_shape bra NEXT_ITER;

    mul.wide.u32 %stride_b_val_addr, %bd, 4;
    add.u64 %stride_b_val_addr, %rd_bl, %stride_b_val_addr;
    ld.global.u32 %stride_b_val, [%stride_b_val_addr+40];

    mad.lo.u32 %off_b, %coord, %stride_b_val, %off_b;

NEXT_ITER:
    add.u32 %d, %d, 1;
    bra COORD_LOOP;

COORD_END:
    mul.wide.u32 %addr_a, %off_a, 4;
    add.u64 %addr_a, %rd_a, %addr_a;
    ld.global.f32 %f1, [%addr_a];

    mul.wide.u32 %addr_b, %off_b, 4;
    add.u64 %addr_b, %rd_b, %addr_b;
    ld.global.f32 %f2, [%addr_b];

    add.f32 %f3, %f1, %f2;

    mul.wide.u32 %addr_c, %idx, 4;
    add.u64 %addr_c, %rd_c, %addr_c;
    st.global.f32 [%addr_c], %f3;

L_exit:
    ret;
}

.visible .entry sub_strided_f32(.param .u64 a, .param .u64 b, .param .u64 c, .param .u64 a_layout, .param .u64 b_layout, .param .u64 c_layout, .param .u32 n) {
    .reg .pred %p1, %p_loop, %p_a_in, %p_b_in, %p_a_shape, %p_b_shape;
