        // In real MPI implementation:
        // MPI_Init(&argc, &argv);
        // MPI_Comm_rank(MPI_COMM_WORLD, &rank);
        // MPI_Comm_size(MPI_COMM_WORLD, &size);

        let communicator = MPICommunicator {
            handle: 0xABCDEF12,
            rank: process_group.rank().0,
